<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/stopped"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingBottom="8dp" />

        <TextView
            android:id="@+id/tvCounter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nbrs de Cliquetis : 0"
            android:textSize="22sp"
            android:gravity="center"
            android:paddingBottom="8dp" />

        <TextView
            android:id="@+id/tvInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Bruit: 0.0000  |  Bande: 0.0000"
            android:textSize="12sp"
            android:gravity="center"
            android:paddingBottom="8dp" />

        <com.example.cortexknock.SpectrumView
            android:id="@+id/spectrumView"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingBottom="12dp">

            <Button
                android:id="@+id/btnStart"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/start" />

            <Button
                android:id="@+id/btnStop"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:enabled="false"
                android:text="@string/stop" />

            <Button
                android:id="@+id/btnReset"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/reset" />
        </LinearLayout>

        <TextView
            android:id="@+id/lblSens"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sensibilité : 4.0" />

        <SeekBar
            android:id="@+id/sbSens"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="29" />

        <TextView
            android:id="@+id/lblFmin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Fréquence basse : 6000 Hz" />

        <SeekBar
            android:id="@+id/sbFmin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="50" />

        <TextView
            android:id="@+id/lblFmax"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Fréquence haute : 9000 Hz" />

        <SeekBar
            android:id="@+id/sbFmax"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="67" />

        <TextView
            android:id="@+id/lblCooldown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Anti-doublons : 50 ms" />

        <SeekBar
            android:id="@+id/sbCooldown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="4" />

        <!-- ✅ Bouton de calibrage par alésage -->
        <Button
            android:id="@+id/btnCalibrate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/calibrate_cylinder" />

        <!-- ✅ Bouton d'aide -->
        <Button
            android:id="@+id/btnHelp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/help" />
        <!-- ✅ Bouton vers la page de réglage d'avance -->
        <Button
            android:id="@+id/btnTiming"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/open_timing" />

        <!-- ✅ Texte "Cortex powered" en bleu -->
        <TextView
            android:id="@+id/tvPoweredBy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:paddingBottom="12dp"
            android:text="@string/powered_by"
            android:textSize="14sp"
            android:textStyle="italic"
            android:textColor="#2196F3"
            android:gravity="center" />

    </LinearLayout>
</ScrollView>
